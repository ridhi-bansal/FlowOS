# ============================================================================
# FlowOS runs in one of two modes, decided entirely by whether the three
# NEXT_PUBLIC_SUPABASE_* / SUPABASE_* variables below are set:
#
#   Unset  -> LOCAL MODE  — IndexedDB (lib/data/local) + localStorage auth
#             (lib/auth/local.ts). No account setup needed, just run it.
#   Set    -> CLOUD MODE  — Supabase Postgres + Supabase Auth, real
#             multi-user persistence protected by Row Level Security.
#
# Nothing below is required to run FlowOS locally. Fill in the Supabase
# section only when you're ready to switch to cloud mode.
# ============================================================================

# --- Supabase (optional — enables cloud mode) -------------------------------
# From your Supabase project: Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the client, NEVER commit a real value here.
# Only used by lib/supabase/admin.ts for trusted server-side operations —
# nothing in the current app calls it yet.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the app — used for auth redirect links (email confirmation,
# password reset). Update this to your real domain once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI (optional) ---------------------------------------------------------
# Provider selection:
#   AI_PROVIDER=gemini    -> Google Gemini API (needs GEMINI_API_KEY)
#   AI_PROVIDER=anthropic -> Anthropic Claude API (needs ANTHROPIC_API_KEY)
#   AI_PROVIDER=mock      -> Local deterministic mock provider (default)
AI_PROVIDER=mock

# Google Gemini (Server-only)
GEMINI_API_KEY=
# Optional: defaults to gemini-3.8-flash (e.g. gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Anthropic Claude (Server-only)
ANTHROPIC_API_KEY=
# Optional: defaults to claude-sonnet-4-6
# AI_MODEL=claude-sonnet-4-6

# --- Google Calendar Integration (optional — cloud mode only) -------------
# Server-only secrets. NEVER expose to the client, NEVER prefix with NEXT_PUBLIC_.
# Obtain OAuth credentials from Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte secret used to encrypt OAuth tokens at rest in Postgres (AES-256-GCM).
# Recommended format: 64-character hex string generated via `openssl rand -hex 32`.
GOOGLE_ENCRYPTION_SECRET=
